# 1. Locate an installed JDK 17 or 21 (avoiding Android Studio's JDK 25)
$searchRoots = @(
    "C:\Program Files\Microsoft",
    "C:\Program Files\Eclipse Adoptium",
    "C:\Program Files\Java",
    "C:\Program Files\Amazon Corretto",
    "C:\Program Files\Zulu",
    "$env:LOCALAPPDATA\Programs"
)

$jdkPath = $null
foreach ($root in $searchRoots) {
    if (Test-Path $root) {
        foreach ($dir in (Get-ChildItem -Path $root -Directory -ErrorAction SilentlyContinue)) {
            $javaExe = Join-Path $dir.FullName "bin\java.exe"
            if (Test-Path $javaExe) {
                $verOutput = (& $javaExe -version 2>&1) | Out-String
                if ($verOutput -match '"(17|21)\.') {
                    $jdkPath = $dir.FullName
                    break
                }
            }
        }
    }
    if ($jdkPath) { break }
}

# 2. Install Microsoft OpenJDK 21 if no JDK 17/21 is present
if (-not $jdkPath) {
    Write-Host "Installing Microsoft OpenJDK 21..." -ForegroundColor Cyan
    winget install --id Microsoft.OpenJDK.21 -e --accept-source-agreements --accept-package-agreements
    $jdkPath = Get-ChildItem "C:\Program Files\Microsoft\jdk-21*" -Directory -ErrorAction SilentlyContinue |
        Select-Object -First 1 -ExpandProperty FullName
}

if (-not $jdkPath -or -not (Test-Path "$jdkPath\bin\java.exe")) {
    Write-Error "Could not locate or install JDK 21. Install JDK 21 manually and set JAVA_HOME."
    return
}

$env:JAVA_HOME = $jdkPath
Write-Host "Using JAVA_HOME = $env:JAVA_HOME" -ForegroundColor Green

# 3. Generate Gradle 8.10.2 wrapper in a clean temp folder
$zip = "$env:TEMP\gradle-8.10.2-bin.zip"
$tempDir = "$env:TEMP\gradle-bootstrap"
New-Item -ItemType Directory -Path "$tempDir\init" -Force | Out-Null

Invoke-WebRequest -Uri "https://services.gradle.org/distributions/gradle-8.10.2-bin.zip" -OutFile $zip
Expand-Archive -Path $zip -DestinationPath $tempDir -Force

Push-Location "$tempDir\init"
& "$tempDir\gradle-8.10.2\bin\gradle.bat" wrapper --gradle-version 8.10.2
Pop-Location

# 4. Copy wrapper files into CustomCallApp (preserves gradle\libs.versions.toml)
Copy-Item "$tempDir\init\gradlew.bat", "$tempDir\init\gradlew" -Destination . -Force
New-Item -ItemType Directory -Path ".\gradle" -Force | Out-Null
Copy-Item "$tempDir\init\gradle\wrapper" -Destination ".\gradle\" -Recurse -Force

# 5. Clean up temp files
Remove-Item $zip, $tempDir -Recurse -Force

